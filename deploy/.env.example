# Full installed WoW 1.12.1 client directory, NOT its Data subdirectory.
# Container UID 10001 needs directory traversal and read access to MPQs.
WOW_CLIENT_DIR=/srv/WoW
BENILLA_IMAGE=benilla-web:local
BENILLA_PORT=8000
BENILLA_BIND_IP=0.0.0.0

# Empty: browser uses the page origin, usually the best choice.
# Example for HTTPS/reverse proxy: https://wow.example.org
BENILLA_PUBLIC_URL=
# Optional shared host: derives http://HOST:BENILLA_PORT for the browser and
# uses HOST for auth/world too unless UPSTREAM_HOST overrides it.
BENILLA_HOST=

# WoW server ports published on the Docker host (not 127.0.0.1 of this container).
# Leave empty to use BENILLA_HOST, or host.docker.internal when both are empty.
UPSTREAM_HOST=host.docker.internal
AUTH_PORT=3724
WORLD_PORT=8085
# Optional host:port overrides; DNS names and [IPv6]:port accepted by launcher.
AUTH_UPSTREAM=
WORLD_UPSTREAM=
